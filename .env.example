# AI provider keys. Configure at least one for LLM classification; fallback remains available.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Required in deployed environments for signed session tokens.
SESSION_TOKEN_SECRET=replace-with-a-long-random-secret
SESSION_TOKEN_MAX_AGE=86400

# Restrict browser origins to the deployed frontend URL(s), comma-separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin account is created on startup only when both values are configured.
ADMIN_NAME=Master Agent
ADMIN_PHONE=9000000999
ADMIN_PASSWORD=AdminTest123
